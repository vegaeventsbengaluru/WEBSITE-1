  <!-- Enquiry success popup -->
  <div id="successModal" class="success-modal" role="dialog" aria-modal="true" aria-labelledby="successTitle" aria-describedby="successMessage">
    <div class="success-card">
      <div class="success-mark"><i class="fa-solid fa-check" aria-hidden="true"></i></div>
      <p class="eyebrow mb-3">VEGA EVENTS</p>
      <h2 id="successTitle">Thank You for Choosing Us!</h2>
      <p id="successMessage">Your enquiry has been received successfully. Our customer executive will contact you shortly to discuss your event and help bring your vision to life. Thank you for considering VEGA EVENTS for your special occasion.</p>
      <button id="closeSuccessModal" type="button" class="shine rounded-full gold-bg px-8 py-3 text-[.68rem] font-bold uppercase tracking-[.17em] text-[#0C2322]">Continue Exploring</button>
    </div>
