  <button id="backToTop" aria-label="Back to top" class="fixed bottom-5 right-5 z-40 grid h-11 w-11 translate-y-4 place-items-center rounded-full bg-[#0C2322] text-[#E2C78A] opacity-0 shadow-xl transition duration-300 pointer-events-none hover:bg-[#183b38"><i class="fa-solid fa-arrow-up"></i></button>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    // Service content is data-driven so you can add, remove or reorder services easily.
    const services = [
      { title: 'Weddings & Engagements', icon: 'fa-ring', image: 'photo-1519741497674-611481863552', text: 'Personalised wedding concepts, engagement ceremonies, elegant decor, guest coordination and seamless celebrations.' },
      { title: 'Birthdays & Private Parties', icon: 'fa-cake-candles', image: 'photo-1530103862676-de8c9debad1d', text: 'Memorable birthday parties, surprise celebrations, private gatherings and milestone moments with a personal touch.' },
      { title: 'Anniversaries & Milestones', icon: 'fa-heart', image: 'photo-1519225421980-715cb0215aed', text: 'Romantic anniversaries, family celebrations and meaningful occasions styled around your story.' },
      { title: 'Baby Showers & Naming Ceremonies', icon: 'fa-baby', image: 'photo-1511895426328-dc8714191300', text: 'Warm, joyful celebrations with thoughtful themes, floral styling, keepsake details and family-friendly planning.' },
      { title: 'Corporate Events & Conferences', icon: 'fa-briefcase', image: 'photo-1511578314322-379afb476865', text: 'Conferences, annual days, award nights, team events and executive gatherings delivered professionally.' },
      { title: 'Product Launches & Brand Activations', icon: 'fa-bullhorn', image: 'photo-1492684223066-81342ee5ff30', text: 'Launch experiences, promotional events and brand activations designed to attract attention and create impact.' },
      { title: 'Concerts & Live Shows', icon: 'fa-music', image: 'photo-1501386761578-eac5c94b800a', text: 'Live performances, stage production, artist coordination, audience flow and high-energy event experiences.' },
      { title: 'DJ Nights & Music Parties', icon: 'fa-headphones', image: 'photo-1470229722913-7c0e2dbbafd3', text: 'DJ nights, college parties and themed music events with immersive lighting, sound and entertainment.' },
      { title: 'College Events & Graduations', icon: 'fa-graduation-cap', image: 'photo-1523580494863-6f3031224c94', text: 'College fests, farewells, graduations, cultural days and student celebrations with smooth coordination.' },
      { title: 'Cultural & Community Events', icon: 'fa-people-group', image: 'photo-1514525253161-7a46d19cd819', text: 'Festivals, traditional celebrations, community programmes and public events planned with care.' },
      { title: 'Decor, Floral Styling & Themes', icon: 'fa-spa', image: 'photo-1507504031003-b417219a0fde', text: 'Stage backdrops, floral arrangements, entrance styling, table settings and custom visual themes.' },
      { title: 'Stage, Lighting & Sound', icon: 'fa-lightbulb', image: 'photo-1506157786151-b8491531f063', text: 'Stage design, lighting concepts, sound systems, LED displays and production support for events of every scale.' },
      { title: 'Photography & Videography', icon: 'fa-camera-retro', image: 'photo-1511285560929-80b456fea0bc', text: 'Event photography, cinematic films, candid moments, highlight reels and memories worth keeping.' },
      { title: 'Entertainment & Artist Management', icon: 'fa-microphone-lines', image: 'photo-1501612780327-45045538702b', text: 'Artist bookings, emcees, performers, hosts, talent coordination and event-day schedules.' },
      { title: 'Venue & Guest Coordination', icon: 'fa-location-dot', image: 'photo-1519167758481-83f550bb49b3', text: 'Venue sourcing, guest logistics, seating plans, hospitality and on-the-day coordination.' },
      { title: 'Complete Event Management', icon: 'fa-list-check', image: 'photo-1464366400600-7168b8af9bc3', text: 'End-to-end planning, vendor coordination, timelines, budgets and execution from concept to closing.' }
    ];

    const serviceGrid = document.getElementById('serviceGrid');
    serviceGrid.innerHTML = services.map((service, index) => `
      <article class="service-card group overflow-hidden rounded-2xl" data-aos="fade-up" data-aos-delay="${(index % 3) * 80}">
        <div class="relative h-52 overflow-hidden bg-[#e5dfd3]"><img class="service-image h-full w-full object-cover" loading="lazy" src="https://images.unsplash.com/${service.image}?auto=format&fit=crop&w=900&q=80" alt="${service.title}" onerror="this.style.display='none'" /><div class="absolute inset-0 bg-gradient-to-t from-[#0C2322]/50 to-transparent"></div><span class="absolute bottom-4 left-5 text-[.62rem] font-bold uppercase tracking-[.22em] text-white">VEGA / ${String(index + 1).padStart(2, '0')}</span></div>
        <div class="p-6 sm:p-7"><div class="service-icon mb-5 grid h-12 w-12 place-items-center rounded-xl border border-[#C5A059]/30 bg-[#C5A059]/10 text-xl text-[#B18A43]"><i class="fa-solid ${service.icon}"></i></div><h3 class="serif mb-3 text-2xl font-semibold">${service.title}</h3><p class="mb-5 text-sm leading-7 text-[#0C2322]/65">${service.text}</p><a href="#inquire" data-service="${service.title}" class="service-link inline-flex items-center text-[.65rem] font-bold uppercase tracking-[.16em] text-[#A6813F] hover:text-[#0C2322]">Explore this service <i class="fa-solid fa-arrow-right ml-2 transition-transform group-hover:translate-x-1"></i></a></div>
      </article>`).join('');

    // Keep motion tasteful and disable it for visitors who prefer reduced motion.
    const animationSettings = {
      duration: 850,
      easing: 'ease-out-cubic',
      once: true,
      offset: 55,
      disable: () => window.matchMedia('(prefers-reduced-motion: reduce)').matches
    };
    if (window.AOS) AOS.init(animationSettings);

    const header = document.getElementById('siteHeader');
    const backToTop = document.getElementById('backToTop');
    const updateScrollUI = () => {
      const scrolled = window.scrollY > 24;
      header.classList.toggle('scrolled', scrolled);
      backToTop.classList.toggle('opacity-0', window.scrollY < 400);
      backToTop.classList.toggle('translate-y-4', window.scrollY < 400);
      backToTop.classList.toggle('pointer-events-none', window.scrollY < 400);
    };
    window.addEventListener('scroll', updateScrollUI, { passive: true });
    updateScrollUI();
    backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    function closeMenu() {
      mobileMenu.classList.remove('open');
      document.body.classList.remove('menu-open');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Open navigation menu');
      menuToggle.innerHTML = '<i class="fa-solid fa-bars"></i>';
    }
    menuToggle.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('open');
      document.body.classList.toggle('menu-open', isOpen);
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
      menuToggle.innerHTML = isOpen ? '<i class="fa-solid fa-xmark"></i>' : '<i class="fa-solid fa-bars"></i>';
    });
    document.querySelectorAll('.mobile-link').forEach(link => link.addEventListener('click', closeMenu));

    // Selecting a service card fills the enquiry form's event type.
    document.querySelectorAll('.service-link').forEach(link => link.addEventListener('click', () => {
      const select = document.getElementById('service');
      const target = link.dataset.service;
      const matching = [...select.options].find(option => option.text.toLowerCase().includes(target.toLowerCase().split(' ')[0]) || target.toLowerCase().includes(option.text.toLowerCase().split(' ')[0]));
      if (matching) select.value = matching.value;
    }));

    // Prevent selecting a date in the past; browser-local date is used.
    const dateInput = document.getElementById('date');
    const today = new Date();
    dateInput.min = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
    document.getElementById('year').textContent = new Date().getFullYear();

    // Submit enquiries in the background so visitors stay on this website.
    const enquiryForm = document.getElementById('enquiryForm');
    const formNote = document.getElementById('formNote');
    const submitButton = enquiryForm.querySelector('button[type="submit"]');
    const successModal = document.getElementById('successModal');
    const closeSuccessModal = document.getElementById('closeSuccessModal');

    function hideSuccessModal() {
      successModal.classList.remove('is-open');
      document.body.classList.remove('modal-open');
      closeSuccessModal.blur();
    }
    closeSuccessModal.addEventListener('click', hideSuccessModal);
    successModal.addEventListener('click', (event) => {
      if (event.target === successModal) hideSuccessModal();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && successModal.classList.contains('is-open')) hideSuccessModal();
    });

    enquiryForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!enquiryForm.reportValidity()) return;
      const originalButtonHTML = submitButton.innerHTML;
      submitButton.disabled = true;
      submitButton.innerHTML = 'Sending Enquiry <i class="fa-solid fa-spinner fa-spin ml-2"></i>';
      formNote.textContent = 'Sending your enquiry securely…';
      formNote.classList.remove('text-red-600');
      try {
        const response = await fetch(enquiryForm.action, {
          method: 'POST',
          body: new FormData(enquiryForm),
          headers: { 'Accept': 'application/json' }
        });
        if (!response.ok) throw new Error('The enquiry could not be submitted.');
        enquiryForm.reset();
        dateInput.min = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
        formNote.textContent = 'Your enquiry has been received. Our customer executive will contact you shortly.';
        successModal.classList.add('is-open');
        document.body.classList.add('modal-open');
        closeSuccessModal.focus();
      } catch (error) {
        formNote.textContent = 'Sorry, we could not send your enquiry right now. Please try again or contact us by phone or email.';
        formNote.classList.add('text-red-600');
      } finally {
        submitButton.disabled = false;
        submitButton.innerHTML = originalButtonHTML;
      }
    });

  </script>
</body>
